{
  "name": "bangladesh-life-simulator",
  "version": "0.6.0",
  "private": true,
  "description": "Open-world life simulation of Bangladesh, playable in the browser. All 8 phases + production persistence path + all-64-district baking. Original IP.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "fetch:world": "node scripts/fetch-dhaka.mjs",
    "fetch:district": "node scripts/fetch-district.mjs",
    "fetch:all": "node scripts/fetch-all.mjs",
    "db:schema": "psql $DATABASE_URL -f db/schema.sql"
  },
  "dependencies": {
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.160.1",
    "zustand": "4.5.2"
  },
  "peerDependencies": {
    "pg": ">=8.11.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "20.14.9",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/three": "0.160.0",
    "typescript": "5.4.5"
  },
  "engines": { "node": ">=18.17.0" }
}
